<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var ViewModelRegistry $viewModels */

use Hyva\Theme\Model\ViewModelRegistry;
use Perspective\ProductReservation\ViewModel\FormData;



$formUrl = $block->getUrl('perspectivereservation/reservation/order');

/** @var FormData $viewModel */
$viewModel = $viewModels->require(FormData::class);
$customerData = [
    'name'  => $viewModel->getCustomerFirstName(),
    'email' => $viewModel->getCustomerEmail(),
    'phone' => $viewModel->getCustomerPhone(),
];
?>

<div x-data="reservationModal()" x-cloak>
    <!-- Кнопка открытия модалки -->
    <button
        type="button"
        class="whitespace-nowrap rounded-radius bg-primary border border-primary px-4 py-2 text-sm font-medium text-on-primary hover:opacity-75 focus:outline-2 focus-offset-2"
        @click="openModal()"
    >
        <?= __('Забронювати на 24 години') ?>
    </button>

    <!-- Модалка -->
    <div
        x-show="modalIsOpen"
        x-transition.opacity.duration.200ms
        x-trap.inert.noscroll="modalIsOpen"
        @keydown.escape.window="closeModal()"
        @click.self="closeModal()"
        class="fixed inset-0 z-30 flex w-full items-start justify-end bg-black/20 p-4 pb-8 backdrop-blur-md lg:p-8"
        role="dialog"
        aria-modal="true"
        aria-labelledby="reservationModalTitle"
    >
        <div
            x-show="modalIsOpen"
            x-transition:enter="transition ease-out duration-200 delay-100"
            x-transition:enter-start="opacity-0 scale-50"
            x-transition:enter-end="opacity-100 scale-100"
            class="flex max-w-lg flex-col gap-4 overflow-hidden rounded-radius border border-outline bg-surface text-on-surface"
        >
            <!-- Header -->
            <div class="flex items-center justify-between border-b p-4">
                <h3 id="reservationModalTitle" class="font-semibold"><?= __('Reservation') ?></h3>
                <button @click="closeModal()" aria-label="Close modal">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <!-- Body / форма -->
            <div class="px-4 py-6">
                <template x-if="message" >
                    <div x-text="message" :class="messageType === 'success' ? 'text-green-600' : 'text-red-600'" class="mb-4"></div>
                </template>

                <form id="reservation-form" @submit.prevent="submitForm">
                    <label class="block mb-1"><?= __('Ім’я') ?> *</label>
                    <input type="text" name="name" x-model="formData.name" class="input-text w-full mb-3 border rounded px-2 py-1" required>

                    <label class="block mb-1"><?= __('Email') ?> *</label>
                    <input type="email" name="email" x-model="formData.email" class="input-text w-full mb-3 border rounded px-2 py-1" required>

                    <label class="block mb-1"><?= __('Телефон') ?></label>
                    <input type="text" name="phone" x-model="formData.phone" class="input-text w-full mb-3 border rounded px-2 py-1">

                    <button type="submit" class="whitespace-nowrap rounded-radius bg-primary border border-primary px-4 py-2 text-sm font-medium text-on-primary hover:opacity-75">
                        <?= __('Submit') ?>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function reservationModal() {
        return {
            modalIsOpen: false,
            message: '',
            messageType: '',
            formData: <?= json_encode($customerData) ?>,
            openModal() { this.modalIsOpen = true; this.message = ''; this.messageType = ''; },
            closeModal() { this.modalIsOpen = false; this.message = ''; this.messageType = ''; },
            submitForm() {
                const form = document.getElementById('reservation-form');
                const formData = new FormData(form);

                formData.append('form_key', hyva.getFormKey());

                const qtyInput = document.querySelector('input[name="qty"]');
                if (qtyInput) formData.append('qty', qtyInput.value);

                const productInput = document.querySelector('input[name="product"]');
                if (productInput) formData.append('product_id', productInput.value);

                fetch('<?= $formUrl ?>', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            this.message = "<?= __('Product reserved successfully!') ?>";
                            this.messageType = 'success';
                            setTimeout(() => this.closeModal(), 1500);
                        } else {
                            this.message = res.message || "<?= __('Error during reservation.') ?>";
                            this.messageType = 'error';
                        }
                    })
                    .catch(err => {
                        this.message = "<?= __('Error during reservation.') ?>";
                        this.messageType = 'error';
                        console.error(err);
                    });
            }
        }
    }
</script>
