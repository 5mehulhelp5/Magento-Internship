            <argument name="configProviders" xsi:type="array">
                <item name="delivery_insurance_checkbox" xsi:type="object">Perspective\WeatherInsurance\Model\Checkout\InsuranceCheckboxConfigProvider</item>
            </argument>
        </arguments>
    </type>
</config>
