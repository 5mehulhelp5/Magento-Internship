<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="billing-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="payment" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="afterMethods" xsi:type="array">

                                                            <!-- Insurance checkbox component -->
                                                            <item name="children" xsi:type="array">
                                                                <item name="delivery_insurance" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Perspective_WeatherInsurance/js/view/delivery-insurance-checkbox</item>
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="template" xsi:type="string">Perspective_WeatherInsurance/delivery-insurance-checkbox</item>
                                                                    </item>
                                                                    <item name="sortOrder" xsi:type="string">0</item>
                                                                    <item name="dataScope" xsi:type="string">delivery_insurance</item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>

                                <!--Insurance Total (Frontend) -->
                                <item name="sidebar" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="summary" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="totals" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="perspective_delivery_insurance_total" xsi:type="array">
                                                            <item name="component" xsi:type="string">Perspective_WeatherInsurance/js/view/checkout/totals/insurance-total</item>
                                                            <item name="sortOrder" xsi:type="string">20</item>
                                                            <item name="config" xsi:type="array">
                                                                <item name="template" xsi:type="string">Perspective_WeatherInsurance/checkout/totals/insurance-total</item>
                                                                <item name="title" xsi:type="string">Insurance Total</item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
