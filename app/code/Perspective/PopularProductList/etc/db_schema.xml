<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="perspective_popular_products" resource="default" engine="innodb">

        <column xsi:type="smallint"
                name="rank"
                unsigned="true"
                nullable="false"
                comment="Rank Position"/>

        <column xsi:type="int"
                name="product_id"
                unsigned="true"
                nullable="false"
                comment="Product ID"/>

        <column xsi:type="int"
                name="orders_count"
                unsigned="true"
                nullable="false"
                default="0"
                comment="Orders with product"/>

        <column xsi:type="timestamp"
                name="updated_at"
                on_update="true"
                default="CURRENT_TIMESTAMP"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rank"/>
        </constraint>
    </table>
</schema>
