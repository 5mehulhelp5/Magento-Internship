<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="perspective_popular_products"
           resource="default"
           engine="innodb"
           comment="Popular Products Table">

        <column xsi:type="int"
                name="product_id"
                unsigned="true"
                nullable="false"
                comment="Entity ID of Product"/>

        <column xsi:type="int"
                name="purchased_qty"
                scale="4"
                precision="12"
                unsigned="true"
                nullable="false"
                default="0"
                comment="Total Purchased Quantity"/>

        <column xsi:type="timestamp"
                name="updated_at"
                on_update="true"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                comment="Last Update Time"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="product_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="FK_POPULAR_PRODUCT_ID"
                    table="perspective_popular_products"
                    column="product_id"
                    referenceTable="catalog_product_entity"
                    referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
</schema>
