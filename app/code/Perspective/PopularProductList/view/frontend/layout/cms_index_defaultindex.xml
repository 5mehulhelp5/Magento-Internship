<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_product_slider" />
    <body>
        <referenceContainer name="content">
            <block name="perspective_testik_testik" template="Perspective_PopularProductList::test.phtml" ttl="60">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Top Ordered Products</argument>
                    <argument name="page_size" xsi:type="number">8</argument> <!-- заменить на значение конфига в шаблоне-->
                    <argument name="hide_details" xsi:type="boolean">true</argument>
                    <argument name="show_heading" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
