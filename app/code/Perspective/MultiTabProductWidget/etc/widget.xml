<?xml version="1.0" encoding="UTF-8"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">

    <widget id="multi_tab_product_widget"
            class="Perspective\MultiTabProductWidget\Block\Product\Widget\MultiTabProductList">
        <label translate="true">MultiTab Products Widget</label>
        <description translate="true">Products List with Tabs</description>

        <parameters>
            <!-- GENERAL SETTINGS -->
            <parameter name="widget_title" xsi:type="text" required="true" visible="true">
                <label translate="true">Widget Title</label>
            </parameter>

            <parameter name="cache_lifetime" xsi:type="text" visible="true">
                <label translate="true">Cache Lifetime (Seconds)</label>
                <description translate="true">
                    <![CDATA[Time in seconds between the widget updates.
                    <br/>If not set, equals to 86400 seconds (24 hours). To update widget instantly, go to Cache Management and clear Blocks HTML Output cache.
                    <br/>Widget will not show products that begin to match the specified conditions until cache is refreshed.]]>
                </description>
            </parameter>

            <parameter name="products_count" xsi:type="text" required="true" visible="true">
                <label translate="true">Products to Display</label>

                <description><![CDATA[
                    <div style="margin:40px 0 0;font-size:1.35em;font-weight:700;">
                        Tab 1 Options
                        <hr style="margin:5px 0 -20px;border:0;border-top:2px solid #ccc;" />
                    </div>]]>
                </description>
                <value>10</value>
            </parameter>

            <!-- TAB 1 -->
            <parameter name="tab_title_1" xsi:type="text" required="true" visible="true">
                <label translate="true">Tab Title</label>
            </parameter>

            <parameter name="tab_conditions_1" xsi:type="select"  required="true" visible="true" source_model="Perspective\MultiTabProductWidget\Model\Config\Source\ConditionList">
                <label translate="true">Select Conditions</label>

                <description><![CDATA[
                    <div style="margin:40px 0 0;font-size:1.35em;font-weight:700;">
                        Tab 2 Options
                        <hr style="margin:5px 0 -20px;border:0;border-top:2px solid #ccc;" />
                    </div>]]>
                </description>
            </parameter>


            <!-- TAB 2 -->
            <parameter name="tab_title_2" xsi:type="text" required="true" visible="true">
                <label translate="true">Tab Title</label>
            </parameter>

            <parameter name="tab_conditions_2" xsi:type="select"  required="true" visible="true" source_model="Perspective\MultiTabProductWidget\Model\Config\Source\ConditionList">
                <label translate="true">Select Conditions</label>

                <description><![CDATA[
                    <div style="margin:40px 0 0;font-size:1.35em;font-weight:700;">
                        Tab 3 Options
                        <hr style="margin:5px 0 -20px;border:0;border-top:2px solid #ccc;" />
                    </div>]]>
                </description>
            </parameter>

            <!-- TAB 3 -->
            <parameter name="tab_title_3" xsi:type="text" required="true" visible="true">
                <label translate="true">Tab Title</label>
            </parameter>

            <parameter name="tab_conditions_3" xsi:type="select"  required="true" visible="true" source_model="Perspective\MultiTabProductWidget\Model\Config\Source\ConditionList">
                <label translate="true">Select Conditions</label>
            </parameter>


            <parameter name="template" xsi:type="select" required="true" visible="true">
                <label>Template</label>
                <options>
                    <option name="default" value="Perspective_MultiTabProductWidget::widget/multi_tab_widget.phtml" selected="true">
                        <label translate="true">Default Template</label>
                    </option>
                </options>
            </parameter>
        </parameters>
    </widget>
</widgets>


